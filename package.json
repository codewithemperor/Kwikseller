{
  "name": "kwikseller",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "cd apps/marketplace && bun run dev",
    "lint": "cd apps/marketplace && bun run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:push": "echo 'Marketplace uses API backend; skipping db:push'",
    "dev:api": "turbo run dev --filter=@kwikseller/api",
    "dev:vendor": "turbo run dev --filter=@kwikseller/api --filter=@kwikseller/vendor",
    "dev:admin": "turbo run dev --filter=@kwikseller/api --filter=@kwikseller/admin",
    "dev:rider": "turbo run dev --filter=@kwikseller/api --filter=@kwikseller/rider ",
    "dev:app": "turbo run dev --filter=@kwikseller/api --filter=@kwikseller/marketplace --filter=@kwikseller/vendor",
    "start": "turbo run start --filter=@kwikseller/api --filter=@kwikseller/marketplace --filter=@kwikseller/admin --filter=@kwikseller/vendor",
    "start:prod": "pnpm build && pnpm start",
    "prisma": "pnpm --filter @kwikseller/api exec prisma",
    "db:generate": "pnpm --filter @kwikseller/api db:generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "prettier": "^3.7.4",
    "turbo": "^2.8.17",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.57.1"
  },
  "engines": {
    "node": ">=18"
  },
   "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@heroui/react": "^3.0.3",
    "@heroui/styles": "^3.0.3",
    "axios": "^1.13.6",
    "framer-motion": "^12.38.0"
  }
}
