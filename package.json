{
  "name": "kwikseller",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "cd apps/vendor && next dev -p 3000",
    "lint": "cd apps/marketplace && bun run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:push": "echo 'Marketplace uses API backend; skipping db:push'",
    "dev:api": "turbo run dev --filter=@kwikseller/api",
    "dev:vendor": "turbo run dev --filter=@kwikseller/api --filter=@kwikseller/vendor",
    "dev:admin": "turbo run dev --filter=@kwikseller/api --filter=@kwikseller/admin",
    "dev:app": "turbo run dev --filter=@kwikseller/api --filter=@kwikseller/marketplace",
    "start": "turbo run start --filter=@kwikseller/api --filter=@kwikseller/marketplace --filter=@kwikseller/vendor",
    "start:prod": "pnpm build && pnpm start",
    "prisma": "pnpm --filter @kwikseller/api exec prisma",
    "db:generate": "pnpm --filter @kwikseller/api db:generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.1",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "prettier": "^3.7.4",
    "turbo": "^2.8.17",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.57.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@internationalized/date": "^3.12.1",
    "@react-aria/i18n": "^3.13.1",
    "@react-aria/ssr": "^3.10.1",
    "@react-aria/utils": "^3.34.1",
    "axios": "^1.13.6",
    "framer-motion": "^12.38.0",
    "react-aria": "^3.51.0",
    "react-aria-components": "^1.20.0"
  }
}
