// KWIKSELLER - Africa's Most Powerful Commerce Operating System
// Prisma Schema - Complete Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== USER & AUTH ====================

enum UserRole {
  BUYER
  VENDOR
  ADMIN
  RIDER
  SUPER_ADMIN
}

enum VerificationStatus {
  NOT_SUBMITTED
  PENDING_REVIEW
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum OnboardingStep {
  NOT_STARTED
  PROFILE_SETUP
  DOCUMENT_UPLOAD
  BANK_DETAILS
  VEHICLE_INFO
  COMPLETED
}

enum KycDocumentType {
  CAC
  BVN
  TIN
  NIN
  DRIVERS_LICENSE
  VEHICLE_REGISTRATION
  VEHICLE_INSURANCE
  PASSPORT
  UTILITY_BILL
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING
}

model User {
  id            String        @id @default(cuid())
  email         String
  phone         String?
  passwordHash  String
  role          UserRole      @default(BUYER)
  status        UserStatus    @default(PENDING)
  emailVerified Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  profile       UserProfile?
  addresses     Address[]
  kycDocuments  KycDocument[]
  store         Store?
  subscription  Subscription?
  kwikCoins     KwikCoins?
  coinTransactions CoinTransaction[]
  vendorMilestones VendorMilestone[]
  referralsAsReferrer Referral[]  @relation("Referrer")
  referralsAsReferee  Referral[]  @relation("Referee")
  ordersAsBuyer Order[]           @relation("BuyerOrders")
  parentCheckouts ParentCheckout[] @relation("BuyerParentCheckouts")
  carts         Cart[]
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  rider         Rider?
  adCampaigns   AdCampaign[]
  wallet        Wallet?
  withdrawals   Withdrawal[]
  adminPermission AdminPermission?
  auditLogs     AuditLog[]
  reviews       Review[]
  productQuestions ProductQuestion[] @relation("ProductQuestionUser")
  productAnswers   ProductQuestion[] @relation("ProductQuestionAnswerer")

  @@unique([email, role])
  @@index([email])
  @@index([role])
  @@index([status])
}

model UserProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  firstName   String?
  lastName    String?
  avatarUrl   String?
  bio         String?
  dateOfBirth DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  line1       String
  line2       String?
  city        String
  stateId     String?
  lgaId       String?
  deliveryInstructions String?
  country     String   @default("Nigeria")
  postalCode  String?
  isDefault   Boolean  @default(false)
  type        String   @default("SHIPPING")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  state State? @relation(fields: [stateId], references: [id])
  lga LocalGovernment? @relation(fields: [lgaId], references: [id])
  orders Order[]

  @@index([userId])
  @@index([stateId])
  @@index([lgaId])
}

model KycDocument {
  id              String           @id @default(cuid())
  userId          String
  type            KycDocumentType
  documentUrl     String
  status          KycStatus        @default(PENDING)
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([type])
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

// ==================== ADMIN PERMISSIONS ====================

enum AdminRole {
  SUPER_ADMIN
  FINANCE
  VENDOR_SUPPORT
  OPERATIONS
  MARKETING
  CONTENT
  CUSTOMER_SUPPORT
  LOGISTICS
  CATALOG_MANAGER
  AUDITOR
}

model AdminPermission {
  id          String     @id @default(cuid())
  adminUserId String     @unique
  role        AdminRole  @default(CONTENT)
  permissions String
  grantedBy   String
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user User @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
}

// ==================== STORE ====================

model Store {
  id                      String             @id @default(cuid())
  vendorId                String             @unique
  name                    String
  slug                    String             @unique
  description             String?
  logoUrl                 String?
  bannerUrl               String?
  category                String?
  isVerified              Boolean            @default(false)
  onboardingComplete      Boolean            @default(false)
  onboardingStep          OnboardingStep     @default(NOT_STARTED)
  onboardingSubmittedAt   DateTime?
  verificationStatus      VerificationStatus @default(NOT_SUBMITTED)
  verificationReviewedAt  DateTime?
  verificationReviewedBy  String?
  rejectionReason         String?
  bankCode                String?
  bankName                String?
  accountNumber           String?
  accountName             String?
  deliverySetupComplete   Boolean            @default(false)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  vendor      User          @relation(fields: [vendorId], references: [id], onDelete: Cascade)
    products    Product[]
    orders      Order[]       @relation("StoreOrders")
    poolOffers  VendorPoolOffer[]
    sourcedPoolOffers VendorPoolOffer[] @relation("PoolSourceStore")
    storefrontDesign StorefrontDesign?
    deliverySetting StoreDeliverySetting?
    deliveryZones StoreDeliveryZone[]

  @@index([vendorId])
  @@index([slug])
  @@index([verificationStatus])
}

model StorefrontDesign {
  id               String   @id @default(cuid())
  storeId          String   @unique
  themePreset      String   @default("CLASSIC")
  navbarTemplate   String   @default("NAVBAR_CLASSIC")
  bottomNavTemplate String  @default("BOTTOM_TABS_CLASSIC")
  layoutTemplate   String   @default("GRID_COMMERCE")
  cartTemplate     String   @default("CART_COMPACT")
  typographyPreset String   @default("FIGTREE_QUESTRIAL")
  primaryColor     String   @default("#071A2F")
  accentColor      String   @default("#F97316")
  fontPairing      String   @default("FIGTREE_QUESTRIAL")
  headingFont      String   @default("SORA")
  bodyFont         String   @default("FIGTREE")
  heroLayout       String   @default("BANNER_LEFT")
  productCardStyle String   @default("CLEAN_GRID")
  sections         String   @default("[\"hero\",\"products\",\"pool\",\"policies\"]")
  heroTitle        String?
  heroSubtitle     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

// ==================== SUBSCRIPTION ====================

enum SubscriptionPlan {
  STARTER
  GROWTH
  PRO
  SCALE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PENDING
}

model Subscription {
  id                  String             @id @default(cuid())
  vendorId            String             @unique
  plan                SubscriptionPlan   @default(STARTER)
  status              SubscriptionStatus @default(PENDING)
  startDate           DateTime?
  endDate             DateTime?
  productLimit        Int                @default(10)
  adCreditsIncluded   Int                @default(0)
  autoRenew           Boolean            @default(false)
  paymentToken        String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  vendor User @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

// ==================== KWIKCOINS & CREDITS ====================

model KwikCoins {
  id              String   @id @default(cuid())
  vendorId        String   @unique
  balance         Int      @default(0)
  totalEarned     Int      @default(0)
  totalSpent      Int      @default(0)
  totalPurchased  Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  vendor User @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

enum CoinTransactionType {
  EARNED
  SPENT
  PURCHASED
  ADJUSTED
  REFERRAL
}

model CoinTransaction {
  id            String              @id @default(cuid())
  vendorId      String
  amount        Int
  type          CoinTransactionType
  source        String?
  balanceAfter  Int
  createdAt     DateTime            @default(now())

  vendor User @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

model Milestone {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String
  description   String?
  coinsAwarded  Int
  isRepeatable  Boolean  @default(false)
}

model VendorMilestone {
  id            String   @id @default(cuid())
  vendorId      String
  milestoneKey  String
  claimedAt     DateTime @default(now())

  vendor User @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@unique([vendorId, milestoneKey])
}

model Referral {
  id            String   @id @default(cuid())
  referrerId    String
  refereeId     String   @unique
  status        String   @default("PENDING")
  coinsAwarded  Int      @default(0)
  createdAt     DateTime @default(now())

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)
}

// ==================== BRANDS (from SQL) ====================

model Brand {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  image       String?
  status      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@index([status])
}

// ==================== BANNERS (from SQL) ====================

enum BannerType {
  MAIN_BANNER
  PROMO_BANNER
  FOOTER_BANNER
  SIDEBAR_BANNER
}

model Banner {
  id              String      @id @default(cuid())
  title           String?
  subTitle        String?
  image           String
  url             String?
  bannerType      BannerType  @default(MAIN_BANNER)
  resourceType    String?     // "product", "category", "brand"
  resourceId      String?
  backgroundColor String?
  buttonText      String?
  position        Int         @default(0)
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([isActive])
  @@index([bannerType])
}

// ==================== DEALS / PROMOTIONS (from SQL) ====================

enum DealType {
  FLASH_DEAL
  DEAL_OF_THE_DAY
  FEATURED_DEAL
  COUPON
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

model Deal {
  id            String       @id @default(cuid())
  title         String
  description   String?
  dealType      DealType     @default(FLASH_DEAL)
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Float        @default(0)
  startDate     DateTime
  endDate       DateTime?
  minOrderValue Float        @default(0)
  maxUses       Int?
  usedCount     Int          @default(0)
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  products DealProduct[]

  @@index([dealType])
  @@index([isActive])
  @@index([startDate])
}

model DealProduct {
  id         String   @id @default(cuid())
  dealId     String
  productId  String
  dealPrice  Float
  createdAt  DateTime @default(now())

  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([dealId, productId])
  @@index([dealId])
}

// ==================== COUPONS (from SQL) ====================

model Coupon {
  id              String       @id @default(cuid())
  code            String       @unique
  title           String
  description     String?
  discountType    DiscountType @default(PERCENTAGE)
  discountValue   Float        @default(0)
  minOrderValue   Float        @default(0)
  maxDiscount     Float?
  maxUses         Int?
  usedCount       Int          @default(0)
  startDate       DateTime
  endDate         DateTime?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  products        CouponProduct[]
  categories      CouponCategory[]

  @@index([code])
  @@index([isActive])
}

model CouponProduct {
  couponId  String
  productId String

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@index([productId])
}

model CouponCategory {
  couponId   String
  categoryId String

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@index([categoryId])
}

model DeliveryRate {
  id                String   @id @default(cuid())
  state             String
  localGovernment   String
  fee               Float    @default(0)
  minDeliveryDays   Int      @default(3)
  maxDeliveryDays   Int      @default(5)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([state, localGovernment])
  @@index([state])
  @@index([isActive])
}

model State {
  id       String  @id @default(cuid())
  name     String  @unique
  code     String  @unique
  isActive Boolean @default(true)

  lgas         LocalGovernment[]
  addresses    Address[]
  storeZones   StoreDeliveryZone[]
  productZones ProductDeliveryZone[]

  @@index([isActive])
}

model LocalGovernment {
  id       String  @id @default(cuid())
  stateId  String
  name     String
  isActive Boolean @default(true)

  state        State @relation(fields: [stateId], references: [id])
  addresses    Address[]
  storeZones   StoreDeliveryZone[]
  productZones ProductDeliveryZone[]

  @@unique([stateId, name])
  @@index([stateId])
  @@index([isActive])
}

enum DeliveryProvider {
  MANUAL
  KWIKSELLER
}

model StoreDeliverySetting {
  id                        String   @id @default(cuid())
  storeId                   String   @unique
  manualDeliveryEnabled     Boolean  @default(true)
  kwiksellerDeliveryEnabled Boolean  @default(false)
  processingDays            Int      @default(1)
  dispatchNote              String?
  returnPolicy              String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  areas StoreDeliveryArea[]

  @@index([storeId])
}

model StoreDeliveryArea {
  id              String   @id @default(cuid())
  settingId       String
  state           String
  localGovernment String?
  fee             Float    @default(0)
  minDeliveryDays Int      @default(3)
  maxDeliveryDays Int      @default(5)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  setting StoreDeliverySetting @relation(fields: [settingId], references: [id], onDelete: Cascade)

  @@unique([settingId, state, localGovernment])
  @@index([settingId])
  @@index([state])
  @@index([isActive])
}

model StoreDeliveryZone {
  id              String   @id @default(cuid())
  storeId         String
  stateId         String
  lgaId           String?
  fee             Float
  minDeliveryDays Int      @default(1)
  maxDeliveryDays Int      @default(5)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  store Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  state State            @relation(fields: [stateId], references: [id])
  lga   LocalGovernment? @relation(fields: [lgaId], references: [id])

  @@unique([storeId, stateId, lgaId])
  @@index([storeId])
  @@index([stateId])
  @@index([lgaId])
  @@index([isActive])
}

model ProductDeliveryZone {
  id              String   @id @default(cuid())
  productId       String
  stateId         String
  lgaId           String?
  fee             Float
  minDeliveryDays Int      @default(1)
  maxDeliveryDays Int      @default(5)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  state   State            @relation(fields: [stateId], references: [id])
  lga     LocalGovernment? @relation(fields: [lgaId], references: [id])

  @@unique([productId, stateId, lgaId])
  @@index([productId])
  @@index([stateId])
  @@index([lgaId])
  @@index([isActive])
}

// ==================== ATTRIBUTES (from SQL) ====================

model Attribute {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values AttributeValue[]
  productAttributes ProductAttribute[]
}

model AttributeValue {
  id          String   @id @default(cuid())
  attributeId String
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attribute Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  productAttributes ProductAttribute[]

  @@index([attributeId])
}

model ProductAttribute {
  id               String @id @default(cuid())
  productId        String
  attributeId      String
  attributeValueId String

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  attribute      Attribute      @relation(fields: [attributeId], references: [id])
  attributeValue AttributeValue @relation(fields: [attributeValueId], references: [id])

  @@unique([productId, attributeId])
  @@index([productId])
  @@index([attributeId])
  @@index([attributeValueId])
}

// ==================== TAGS ====================

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products ProductTag[]
}

// ==================== PRODUCTS ====================

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
  PENDING
}

enum ProductType {
  PHYSICAL
  DIGITAL
}

enum ProductSource {
  VENDOR_STOCK
  POOL_RESALE
  GROUP_BUY
}

enum InventoryPolicy {
  TRACKED
  UNLIMITED
  LICENSE_LIMITED
}

enum DigitalDeliveryType {
  DOWNLOAD
  LICENSE_KEY
  EXTERNAL_ACCESS
}

enum InventoryReservationStatus {
  ACTIVE
  COMMITTED
  RELEASED
  EXPIRED
}

enum ProductCondition {
  NEW
  USED
  REFURBISHED
}

enum MediaType {
  IMAGE
  VIDEO
}

enum RelationType {
  RELATED
  UPSELL
  CROSS_SELL
}

model Product {
  id              String        @id @default(cuid())
  storeId         String
  poolProductId   String?
  name            String
  slug            String
  shortDescription String?
  description     String?
  price           Float
  comparePrice    Float?
  sku             String?
  barcode         String?
  productType     ProductType    @default(PHYSICAL)
  productSource   ProductSource  @default(VENDOR_STOCK)
  inventoryPolicy InventoryPolicy @default(TRACKED)
  requiresShipping Boolean       @default(true)
  useStoreDeliveryZones Boolean  @default(true)
  trackInventory  Boolean        @default(true)
  stock           Int           @default(0)
  lowStock        Int           @default(5)
  minOrderQuantity Int           @default(1)
  maxOrderQuantity Int?
  condition       ProductCondition?
  isPreorder      Boolean       @default(false)
  preorderDate    DateTime?
  weight          Float?
  status          ProductStatus @default(DRAFT)
  categoryId      String?
  brandId         String?
    isFeatured      Boolean       @default(false)
    isPoolProduct   Boolean       @default(false)
    poolEnabled     Boolean       @default(false)
    poolBasePrice   Float?
    poolMinSalePrice Float?
    poolMaxSelectableQuantity Int?
    poolSourceStoreId String?
    poolSourceProductId String?
    poolSourceBasePrice Float?
    poolMargin      Float?
    rating          Float         @default(0)
  reviewCount     Int           @default(0)
  totalSales      Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  store       Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
    poolProduct PoolProduct?    @relation(fields: [poolProductId], references: [id])
  variants    ProductVariant[]
  variantTypes VariantType[]
  images      ProductMedia[]
  attributes  ProductAttribute[]
  dimension   ProductDimension?
  seo         ProductSeo?
  deliveryZones ProductDeliveryZone[]
  digitalAssets DigitalAsset[]
  inventoryItems InventoryItem[]
  deliveryOverride ProductDeliveryOverride?
    vendorPoolOffers VendorPoolOffer[]
    sourcePoolOffers VendorPoolOffer[] @relation("PoolSourceProduct")
  category    Category?       @relation(fields: [categoryId], references: [id])
  brand       Brand?          @relation(fields: [brandId], references: [id])
  cartItems   CartItem[]
  orderItems  OrderItem[]
  adCampaigns AdCampaign[]
  tags        ProductTag[]
  dealProducts DealProduct[]
  couponProducts CouponProduct[]
  reviews     Review[]
  questions   ProductQuestion[]
  relatedProducts RelatedProduct[] @relation("ProductRelations")
  relatedByProducts RelatedProduct[] @relation("RelatedProductRelations")

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([isFeatured])
  @@index([productType])
  @@index([productSource])
    @@index([poolProductId])
    @@index([poolEnabled])
    @@index([poolSourceStoreId])
    @@index([poolSourceProductId])
  }

model ProductDeliveryOverride {
  id                String           @id @default(cuid())
  productId         String           @unique
  useStoreDefault   Boolean          @default(true)
  requiresShipping  Boolean          @default(true)
  provider          DeliveryProvider @default(MANUAL)
  extraFee          Float            @default(0)
  extraHandlingDays Int              @default(0)
  dispatchNote      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVariant {
  id          String   @id @default(cuid())
  productId   String
  name        String
  price       Float
  stock       Int      @default(0)
  sku         String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    VariantValue[] @relation("VariantValueMap")
  cartItems CartItem[]
  orderItems OrderItem[]
  digitalAssets DigitalAsset[]
  inventoryItems InventoryItem[]

  @@index([productId])
}

model VariantType {
  id        String @id @default(cuid())
  productId String
  name      String
  position  Int    @default(0)

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  VariantValue[]

  @@index([productId])
}

model VariantValue {
  id            String  @id @default(cuid())
  variantTypeId String
  value         String
  hexCode       String?
  imageUrl      String?
  position      Int     @default(0)

  type     VariantType      @relation(fields: [variantTypeId], references: [id], onDelete: Cascade)
  variants ProductVariant[] @relation("VariantValueMap")

  @@index([variantTypeId])
}

model ProductDimension {
  id        String @id @default(cuid())
  productId String @unique
  weight    Float?
  length    Float?
  width     Float?
  height    Float?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductSeo {
  id              String  @id @default(cuid())
  productId       String  @unique
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model DigitalAsset {
  id               String              @id @default(cuid())
  productId        String
  variantId        String?
  deliveryType     DigitalDeliveryType @default(DOWNLOAD)
  name             String
  fileUrl          String?
  accessUrl        String?
  licenseKey       String?
  maxDownloads     Int?
  expiresAfterDays Int?
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  fulfillments Fulfillment[]

  @@index([productId])
  @@index([variantId])
  @@index([isActive])
}

model InventoryItem {
  id                String          @id @default(cuid())
  productId         String?
  variantId         String?
  storeId           String?
  poolProductId     String?
  sku               String?
  available         Int             @default(0)
  reserved          Int             @default(0)
  safetyStock       Int             @default(0)
  lowStockThreshold Int             @default(5)
  policy            InventoryPolicy @default(TRACKED)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  product     Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  poolProduct PoolProduct?    @relation(fields: [poolProductId], references: [id], onDelete: Cascade)
  reservations InventoryReservation[]

  @@index([productId])
  @@index([variantId])
  @@index([storeId])
  @@index([poolProductId])
  @@index([sku])
}

model InventoryReservation {
  id              String                     @id @default(cuid())
  inventoryItemId String
  cartItemId      String?
  orderItemId     String?
  quantity        Int
  status          InventoryReservationStatus @default(ACTIVE)
  expiresAt       DateTime
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  cartItem      CartItem?     @relation(fields: [cartItemId], references: [id], onDelete: SetNull)
  orderItem     OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([inventoryItemId])
  @@index([cartItemId])
  @@index([orderItemId])
  @@index([status])
  @@index([expiresAt])
}

model ProductMedia {
  id           String    @id @default(cuid())
  productId    String
  url          String
  mediaType    MediaType @default(IMAGE)
  thumbnailUrl String?
  alt          String?
  position     Int       @default(0)
  isMain       Boolean   @default(false)
  createdAt    DateTime  @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model RelatedProduct {
  productId        String
  relatedProductId String
  type             RelationType @default(RELATED)

  product        Product @relation("ProductRelations", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct Product @relation("RelatedProductRelations", fields: [relatedProductId], references: [id], onDelete: Cascade)

  @@id([productId, relatedProductId, type])
  @@index([relatedProductId])
}

model ProductTag {
  productId   String
  tagId       String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  parentId    String?
  imageUrl    String?
  icon        String?
  isActive    Boolean    @default(true)
  position    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
  couponCategories CouponCategory[]

  @@index([parentId])
  @@index([isActive])
}

// ==================== CART ====================

model Cart {
  id          String     @id @default(cuid())
  userId      String?
  sessionId   String?
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
  @@index([sessionId])
}

model CartItem {
  id          String   @id @default(cuid())
  cartId      String
  productId   String
  variantId   String?
  poolOfferId String?
  quantity    Int
  price       Float
  productType ProductType   @default(PHYSICAL)
  productSource ProductSource @default(VENDOR_STOCK)
  requiresShipping Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  poolOffer VendorPoolOffer? @relation(fields: [poolOfferId], references: [id], onDelete: SetNull)
  reservations InventoryReservation[]

  @@index([cartId])
  @@index([poolOfferId])
}

// ==================== ORDERS ====================

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PENDING
  PAID
  CONFIRMED
  PROCESSING
  FULFILLED
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
}

enum ParentCheckoutStatus {
  PENDING_PAYMENT
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum FulfillmentStatus {
  PENDING
  PROCESSING
  READY
  FULFILLED
  DELIVERED
  FAILED
  CANCELLED
}

enum FulfillmentType {
  PHYSICAL_MANUAL
  DIGITAL_ACCESS
}

model Order {
  id            String        @id @default(cuid())
  buyerId       String
  storeId       String
  parentCheckoutId String?
  status        OrderStatus   @default(PENDING_PAYMENT)
  subtotal      Float
  shippingFee   Float         @default(0)
  discount      Float         @default(0)
  totalAmount   Float
  paymentStatus PaymentStatus @default(PENDING)
  addressId     String?
  checkoutReference String?    @unique
  idempotencyKey String?
  poolOrderId   String?
  couponId      String?
  deliveryRateId String?
  deliveryState String?
  deliveryLocalGovernment String?
  estimatedDeliveryStart DateTime?
  estimatedDeliveryEnd DateTime?
  deliveryRateSnapshot String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  buyer       User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  store       Store       @relation("StoreOrders", fields: [storeId], references: [id])
  parentCheckout ParentCheckout? @relation(fields: [parentCheckoutId], references: [id], onDelete: Cascade)
  address     Address?    @relation(fields: [addressId], references: [id])
  items       OrderItem[]
  payment     Payment?
  escrow      Escrow?
  delivery    Delivery?
  commission  Commission?
  fulfillments Fulfillment[]
  reviews     Review[]

  @@index([buyerId])
  @@index([storeId])
  @@index([parentCheckoutId])
  @@index([status])
  @@index([paymentStatus])
  @@index([idempotencyKey])
}

model ParentCheckout {
  id                String               @id @default(cuid())
  buyerId           String
  status            ParentCheckoutStatus @default(PENDING_PAYMENT)
  subtotal          Float
  shippingFee       Float                @default(0)
  discount          Float                @default(0)
  totalAmount       Float
  paymentStatus     PaymentStatus        @default(PENDING)
  checkoutReference String               @unique
  idempotencyKey    String?
  couponId          String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  buyer   User      @relation("BuyerParentCheckouts", fields: [buyerId], references: [id])
  orders  Order[]
  payment Payment?

  @@index([buyerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([idempotencyKey])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  productId   String
  variantId   String?
  poolOfferId String?
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  isPoolItem  Boolean  @default(false)
  productType ProductType   @default(PHYSICAL)
  productSource ProductSource @default(VENDOR_STOCK)
  sellerStoreId String?
  sourceStoreId String?
  sourceProductId String?
  sourceBasePrice Float?
  resellerMargin Float?
  platformFeeAmount Float?
  fulfillmentStatus FulfillmentStatus @default(PENDING)
  createdAt   DateTime @default(now())

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  poolOffer VendorPoolOffer? @relation(fields: [poolOfferId], references: [id], onDelete: SetNull)
  reservations InventoryReservation[]
  fulfillments Fulfillment[]

  @@index([orderId])
  @@index([poolOfferId])
  @@index([sellerStoreId])
  @@index([sourceStoreId])
  @@index([sourceProductId])
}

// ==================== PAYMENTS ====================

enum PaymentGateway {
  PAYSTACK
  FLUTTERWAVE
  CASH_ON_DELIVERY
  WALLET
}

enum PaymentType {
  CHECKOUT
  ORDER
  SUBSCRIPTION
  CREDIT_PURCHASE
}

model Payment {
  id            String         @id @default(cuid())
  orderId       String?        @unique
  parentCheckoutId String?     @unique
  entityType    PaymentType
  entityId      String
  amount        Float
  gateway       PaymentGateway
  reference     String         @unique
  status        PaymentStatus  @default(PENDING)
  authorizationUrl String?
  metadata      String?
  gatewayResponse String?
  paidAt        DateTime?
  verifiedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)
  parentCheckout ParentCheckout? @relation(fields: [parentCheckoutId], references: [id], onDelete: Cascade)

  @@index([reference])
  @@index([entityType, entityId])
}

model PaymentWebhookEvent {
  id             String    @id @default(cuid())
  gateway        PaymentGateway
  eventType      String
  idempotencyKey String    @unique
  reference      String?
  status         String    @default("RECEIVED")
  payload        String?
  error          String?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([gateway])
  @@index([reference])
  @@index([status])
}

model Fulfillment {
  id             String            @id @default(cuid())
  orderId        String
  orderItemId    String?
  type           FulfillmentType
  status         FulfillmentStatus @default(PENDING)
  manualCarrier  String?
  trackingNumber String?
  digitalAssetId String?
  accessUrl      String?
  deliveredAt    DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem    OrderItem?    @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  digitalAsset DigitalAsset? @relation(fields: [digitalAssetId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([orderItemId])
  @@index([status])
  @@index([type])
}

// ==================== ESCROW ====================

enum EscrowStatus {
  HELD
  RELEASED
  DISPUTED
  PARTIAL
}

model Escrow {
  id             String        @id @default(cuid())
  orderId        String        @unique
  vendorId       String
  amount         Float
  status         EscrowStatus  @default(HELD)
  releaseAt      DateTime?
  releasedAt     DateTime?
  disputeReason  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([vendorId])
  @@index([status])
}

// ==================== WALLET ====================

model Wallet {
  id                String   @id @default(cuid())
  vendorId          String   @unique
  availableBalance  Float    @default(0)
  pendingBalance    Float    @default(0)
  totalEarned       Float    @default(0)
  totalWithdrawn    Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  vendor User @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model Withdrawal {
  id            String           @id @default(cuid())
  vendorId      String
  amount        Float
  bankCode      String
  accountNumber String
  accountName   String
  status        WithdrawalStatus @default(PENDING)
  reference     String?
  processedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  vendor User @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@index([status])
}

enum WithdrawalStatus {
  PENDING
  PROCESSED
  FAILED
}

// ==================== COMMISSION ====================

model Commission {
  id                  String   @id @default(cuid())
  orderId             String   @unique
  vendorId            String
  saleAmount          Float
  platformFeePercent  Float
  platformFeeAmount   Float
  vendorEarnings      Float
  plan                String
  settledAt           DateTime?
  createdAt           DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([vendorId])
}

// ==================== POOL ====================

model PoolProduct {
  id              String   @id @default(cuid())
  name            String
  description     String?
  wholesalePrice  Float
  suggestedRetailPrice Float?
  productType     ProductType @default(PHYSICAL)
  status          PoolProductStatus @default(DRAFT)
  categoryId      String?
  category        String?
  stock           Int      @default(0)
  supplierId      String?
  images          String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products Product[]
  inventoryItems InventoryItem[]
  vendorOffers VendorPoolOffer[]
  campaigns PoolCampaign[]

  @@index([category])
  @@index([categoryId])
  @@index([isActive])
  @@index([status])
}

enum PoolProductStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum PoolOfferStatus {
  DRAFT
  ACTIVE
  PAUSED
}

model VendorPoolOffer {
    id              String   @id @default(cuid())
    storeId         String
    poolProductId   String?
    sourceType      PoolSourceType @default(ADMIN_POOL)
    sourceStoreId   String?
    sourceProductId String?
    sourceBasePrice Float          @default(0)
    productId       String?
    retailPrice     Float
    markup          Float    @default(0)
  status          PoolOfferStatus @default(DRAFT)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

    store       Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
    sourceStore Store?      @relation("PoolSourceStore", fields: [sourceStoreId], references: [id], onDelete: SetNull)
    sourceProduct Product?  @relation("PoolSourceProduct", fields: [sourceProductId], references: [id], onDelete: SetNull)
    poolProduct PoolProduct? @relation(fields: [poolProductId], references: [id], onDelete: Cascade)
    product     Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  cartItems   CartItem[]
  orderItems  OrderItem[]

    @@unique([storeId, sourceType, poolProductId])
    @@unique([storeId, sourceType, sourceProductId])
    @@index([storeId])
    @@index([sourceStoreId])
    @@index([sourceProductId])
    @@index([status])
  }

  enum PoolSourceType {
    ADMIN_POOL
    VENDOR_PRODUCT
  }

  enum PoolSettlementStatus {
    HELD
    RELEASED
    CANCELLED
    DISPUTED
  }

  model PoolSettlement {
    id                  String               @id @default(cuid())
    orderId             String
    orderItemId         String
    buyerStoreId        String
    sourceStoreId       String?
    sourceProductId     String?
    poolOfferId         String?
    quantity            Int
    saleAmount          Float
    sourceAmount        Float
    resellerMargin      Float
    platformFeeAmount   Float               @default(0)
    status              PoolSettlementStatus @default(HELD)
    releasedAt          DateTime?
    createdAt           DateTime             @default(now())
    updatedAt           DateTime             @updatedAt

    @@index([orderId])
    @@index([orderItemId])
    @@index([buyerStoreId])
    @@index([sourceStoreId])
    @@index([poolOfferId])
    @@index([status])
  }

enum PoolCampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  THRESHOLD_MET
  FULFILLING
  COMPLETED
  CANCELLED
}

model PoolCampaign {
  id                String             @id @default(cuid())
  poolProductId     String
  title             String
  targetQuantity    Int
  committedQuantity Int                @default(0)
  unitPrice         Float
  status            PoolCampaignStatus @default(DRAFT)
  startsAt          DateTime
  endsAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  poolProduct PoolProduct @relation(fields: [poolProductId], references: [id], onDelete: Cascade)

  @@index([poolProductId])
  @@index([status])
  @@index([startsAt])
}

// ==================== ADS ====================

enum AdType {
  FEATURED
  BANNER
  SEARCH_BOOST
  FLASH_DEAL
}

enum AdStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  PENDING
}

model AdCampaign {
  id            String    @id @default(cuid())
  vendorId      String
  productId     String?
  name          String
  type          AdType
  budget        Int
  spent         Int       @default(0)
  startDate     DateTime
  endDate       DateTime?
  status        AdStatus  @default(PENDING)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  vendor      User            @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  product     Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  impressions AdImpression[]

  @@index([vendorId])
  @@index([status])
}

model AdImpression {
  id           String   @id @default(cuid())
  campaignId   String
  date         DateTime @default(now())
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  conversions  Int      @default(0)

  campaign AdCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
}

// ==================== RIDERS ====================

model Rider {
  id                      String             @id @default(cuid())
  userId                  String             @unique
  vehicleBrand            String?
  vehicleModel            String?
  vehicleYear             Int?
  vehicleColor            String?
  licenseNumber           String?
  licenseExpiry           DateTime?
  isAvailable             Boolean            @default(false)
  onboardingComplete      Boolean            @default(false)
  onboardingStep          OnboardingStep     @default(NOT_STARTED)
  onboardingSubmittedAt   DateTime?
  verificationStatus      VerificationStatus @default(NOT_SUBMITTED)
  verificationReviewedAt  DateTime?
  verificationReviewedBy  String?
  rejectionReason         String?
  bankCode                String?
  bankName                String?
  accountNumber           String?
  accountName             String?
  rating                  Float              @default(0)
  totalDeliveries         Int                @default(0)
  totalEarnings           Float              @default(0)
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries Delivery[]

  @@index([isAvailable])
  @@index([verificationStatus])
}

enum DeliveryStatus {
  ASSIGNED
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED
}

model Delivery {
  id               String         @id @default(cuid())
  orderId          String         @unique
  riderId          String
  status           DeliveryStatus @default(ASSIGNED)
  pickupPhotoUrl   String?
  deliveryPhotoUrl String?
  otp              String?
  assignedAt       DateTime       @default(now())
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  order Order @relation(fields: [orderId], references: [id])
  rider Rider @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([status])
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  data      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model PushSubscription {
  id         String   @id @default(cuid())
  userId     String
  endpoint   String   @unique
  p256dh     String
  auth       String
  deviceName String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==================== LOGS ====================

model EmailLog {
  id        String   @id @default(cuid())
  recipient String
  template  String
  status    String
  error     String?
  sentAt    DateTime @default(now())

  @@index([recipient])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  changes   String?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([action])
}

// ==================== REVIEWS ====================

model Review {
  id          String   @id @default(cuid())
  productId   String
  userId      String
  orderId     String?
  rating      Int
  title       String?
  comment     String?
  images      String?
  isApproved  Boolean  @default(false)
  isVerifiedPurchase Boolean @default(false)
  helpfulCount Int     @default(0)
  vendorReply String?
  vendorRepliedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([orderId])
}

model ProductQuestion {
  id          String    @id @default(cuid())
  productId   String
  userId      String
  question    String
  answer      String?
  answeredBy  String?
  answeredAt  DateTime?
  isApproved  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user     User    @relation("ProductQuestionUser", fields: [userId], references: [id], onDelete: Cascade)
  answerer User?   @relation("ProductQuestionAnswerer", fields: [answeredBy], references: [id])

  @@index([productId])
  @@index([userId])
  @@index([answeredBy])
}

// ==================== WISHLIST ====================

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

// ==================== SYSTEM CONFIG ====================

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==================== CURRENCY (from SQL) ====================

model Currency {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  symbol    String
  exchangeRate Float  @default(1)
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([code])
  @@index([isActive])
}
